{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jevtown-cn",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 只有 API 走 Worker；页面、样式和脚本直接从边缘出，不计 Worker 请求。
    "run_worker_first": ["/api/*"]
  },
  // database_id：2026-09-30 上线时 `npx wrangler d1 create jevtown` 的产物；本地开发只认 database_name。
  "d1_databases": [{ "binding": "DB", "database_name": "jevtown", "database_id": "adccbaa8-3a14-423f-951c-0442d2f7bc64", "migrations_dir": "migrations" }],
  "vars": {
    // 文本最多传几波：1 = 只有第一波 600 人，4 = 全城。
    "CROWD_MAX_WAVES": "4",
    // 2026-11-01：默认通道 = 站方自建中转 Logicc（jev.logicc.top，System One 形状与
    // TypeSafe 相同）——Zen 免费匿名档实测 451（端点已死）、TypeSafe 官方对本地区域封锁。
    // 通道 key 由站方以 Worker secret LOGICC_API_KEY 持有（wrangler secret put，绝不入库）；
    // 访客 BYOK 头仍优先于它。本地开发与测试的 mock 由 .dev.vars 的 JEV_PROVIDER=mock 决定。
    "JEV_PROVIDER": "logicc"
  },
  "observability": { "enabled": true }
}
