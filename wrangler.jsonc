{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jevtown-cn",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 只有 API 走 Worker；页面、样式和脚本直接从边缘出，不计 Worker 请求。
    "run_worker_first": ["/api/*"]
  },
  // database_id：2026-09-30 上线时 `npx wrangler d1 create jevtown` 的产物；本地开发只认 database_name。
  "d1_databases": [{ "binding": "DB", "database_name": "jevtown", "database_id": "adccbaa8-3a14-423f-951c-0442d2f7bc64", "migrations_dir": "migrations" }],
  "vars": {
    // 文本最多传几波：1 = 只有第一波 600 人，4 = 全城。
    "CROWD_MAX_WAVES": "4",
    // 2026-10-07：默认通道 = OpenCode Zen 免费档（jev-1.13-free，匿名可用、零花费），
    // 访客不填 key 也有真实 Jev；BYOK 头与站方 secret（OPENCODE_API_KEY，可选，更稳）
    // 都优先于它。本地开发与测试的 mock 由 .dev.vars 的 JEV_PROVIDER=mock 决定。
    "JEV_PROVIDER": "opencode"
  },
  "observability": { "enabled": true }
}
