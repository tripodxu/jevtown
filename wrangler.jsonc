{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jevtown-cn",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 只有 API 走 Worker；页面、样式和脚本直接从边缘出，不计 Worker 请求。
    "run_worker_first": ["/api/*"]
  },
  // database_id：2026-09-30 上线时 `npx wrangler d1 create jevtown` 的产物；本地开发只认 database_name。
  "d1_databases": [{ "binding": "DB", "database_name": "jevtown", "database_id": "adccbaa8-3a14-423f-951c-0442d2f7bc64", "migrations_dir": "migrations" }],
  "vars": {
    // 文本最多传几波：1 = 只有第一波 600 人，4 = 全城。
    "CROWD_MAX_WAVES": "4",
    // R28：站点不提供站方 key，真实检查一律走访客 BYOK；留 mock 仅为本地开发兜底。
    "JEV_PROVIDER": "mock"
  },
  "observability": { "enabled": true }
}
